{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "ecommerce-platform-api": {
      "root": "backend",
      "framework": "express",
      "buildCommand": "npm ci"
    },
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
