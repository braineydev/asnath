# ---------------------------------------------------------------------------
# Asnath frontend configuration. Copy to frontend/.env.local and fill in.
# Variables prefixed NEXT_PUBLIC_ are embedded in the browser bundle: never put
# a secret in one of them.
# ---------------------------------------------------------------------------

# --- Required (server-only) ------------------------------------------------
# Supabase project URL (Supabase dashboard > Project Settings > API).
SUPABASE_URL=https://tcuhwrxenknjkkdwxrfz.supabase.co
# Server-only privileged key (same page, "service_role" / secret key).
# Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# --- Required in production ------------------------------------------------
# Public canonical URL for metadata, robots and sitemap generation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Store details (all optional; the UI hides what is not set) -------------
# WhatsApp number for orders and enquiries, international format, digits only
# (for example 2547XXXXXXXX). Without it the WhatsApp buttons open WhatsApp
# without a recipient, so set it before launch.
NEXT_PUBLIC_WHATSAPP_NUMBER=254710298091
# Phone number shown in the footer and contact page.
NEXT_PUBLIC_STORE_PHONE=254710298091
# Contact email shown in the footer and contact page.
NEXT_PUBLIC_STORE_EMAIL=info@asnath.com
# Shop address lines separated by "|", for example "Shop 4, Example Plaza|Nairobi".
NEXT_PUBLIC_STORE_ADDRESS=Shop 4, Example Plaza|Nairobi
# Google Maps "Embed a map" URL (the src value of the iframe) for the contact page.
NEXT_PUBLIC_STORE_MAP_EMBED_URL=

# --- Optional ---------------------------------------------------------------
# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Omit to keep analytics off.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Explicit OAuth callback URL. When omitted, the request origin is used.
# AUTH_CALLBACK_URL=http://localhost:3000/auth/callback
